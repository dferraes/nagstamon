# Maintainer: local build from Nagstamon source tree
# Builds Nagstamon directly from this repository checkout (including local fixes).

pkgname=nagstamon
pkgver=3.19.20260527
pkgrel=2
pkgdesc='Nagios status monitor for the desktop (local build with Plasma 6 fixes)'
arch=('any')
url='https://nagstamon.de/'
license=('GPL-2.0-only')
depends=(
  'python-pyqt6'
  'python-pyqt6-webengine'
  'python-tzlocal'
  'qt6-multimedia'
  'qt6-svg'
  'python-requests'
  'python-beautifulsoup4'
  'python-keyring'
  'python-psutil'
  'python-requests-kerberos'
  'python-lxml'
  'python-dbus'
  'python-dateutil'
  'python-pysocks'
  'python-arrow'
  'python-cryptography'
  'python-packaging'
  'python-truststore'
)
optdepends=(
  'python-requests-gssapi: used instead of python-requests-kerberos for kerberos auth if present'
  'python-requests-ecp: ECP/SAML authentication support (AUR)'
)
makedepends=('python-setuptools')
# this PKGBUILD is meant to be built inside the repository checkout;
# _srcdir points two levels up from build/arch to the repository root
_srcdir=../..

build() {
  cd "$startdir/$_srcdir"
  python setup.py build
}

package() {
  cd "$startdir/$_srcdir"
  python setup.py install --root="$pkgdir" --optimize=1 --skip-build
  # desktop file and common practice expect the executable as 'nagstamon'
  mv "$pkgdir/usr/bin/nagstamon.py" "$pkgdir/usr/bin/nagstamon"
}
